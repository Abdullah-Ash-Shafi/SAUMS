            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "student_id",
          "semester",
          "status",
          "approved_courses",
          "created_at"
        ],
        "title": "ExamFormResponse",
        "description": "Schema for generated exam form and cleared eligible courses."
      },
