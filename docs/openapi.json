      "put": {
        "tags": [
          "Course Registration & Advising"
        ],
        "summary": "Approve Registration",
        "description": "Approve a student's course registration.\n\nTransitions enrollment status: PENDING -> APPROVED.\nRestricted to Teacher and DepartmentAdmin.",
