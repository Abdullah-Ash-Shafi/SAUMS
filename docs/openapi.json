  "components": {
    "schemas": {
      "CourseCreate": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "credits": {
            "type": "number",
            "title": "Credits"
          },
          "seat_capacity": {
            "type": "integer",
            "title": "Seat Capacity",
            "default": 60
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "semester": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Semester"
          },
          "prerequisite_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prerequisite Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "title",
          "credits"
        ],
        "title": "CourseCreate",
        "description": "Schema for creating a course in the catalog."
      },
      "CourseRegistrationRequest": {
        "properties": {
          "course_id": {
            "type": "integer",
            "title": "Course Id"
          }
        },
        "type": "object",
        "required": [
          "course_id"
        ],
        "title": "CourseRegistrationRequest",
        "description": "Schema for submitting a course registration."
      },
      "CourseResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "credits": {
            "type": "number",
            "title": "Credits"
          },
          "seat_capacity": {
            "type": "integer",
            "title": "Seat Capacity",
            "default": 60
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "semester": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Semester"
          },
          "prerequisite_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prerequisite Id"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "code",
          "title",
          "credits",
          "id",
          "created_at"
        ],
        "title": "CourseResponse",
        "description": "Schema for course details returned to clients."
      },
      "EnrollmentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "student_id": {
            "type": "integer",
            "title": "Student Id"
          },
          "course_id": {
            "type": "integer",
            "title": "Course Id"
          },
          "status": {
            "$ref": "#/components/schemas/EnrollmentStatus"
          },
          "attendance": {
            "type": "number",
            "title": "Attendance"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "course": {
            "anyOf": [
