          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "description": "Schema for user login credentials."
      },
      "MarkEntryRequest": {
        "properties": {
          "student_id": {
            "type": "integer",
            "title": "Student Id"
          },
          "course_id": {
            "type": "integer",
            "title": "Course Id"
          },
          "ca_marks": {
            "type": "number",
